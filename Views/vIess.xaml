<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="Bisque" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dgAguirreTallerS3.Views.vIess"
             Title="Resumen del contacto">
    <ContentPage.Resources>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="DarkSlateBlue" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="BlueViolet" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Resumen del Contacto"
                   FontSize="Title"
                   HorizontalOptions="Center" />

            <Image Source="iess.png"
                   HeightRequest="150"
                   WidthRequest="150"
                   HorizontalOptions="Center" />

            <Label x:Name="lblIdentificacion" />
            <Label x:Name="lblNombres" />
            <Label x:Name="lblApellidos" />
            <Label x:Name="lblFecha" />
            <Label x:Name="lblEdad" />
            <Label x:Name="lblCorreo" />
            <Label x:Name="lblSalario" />
            <Label x:Name="lblAporte" />

            <Button x:Name="btnExportar"
                    Text="Exportar a archivo de texto"
                    Clicked="btnExportar_Clicked" />

            <Button x:Name="btnRegresar"
        Text="Regresar al inicio"
        Clicked="btnRegresar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>