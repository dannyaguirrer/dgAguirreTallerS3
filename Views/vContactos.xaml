<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dgAguirreTallerS3.Views.vContactos"
             Title="vContactos">
    <VerticalStackLayout
        Padding="20"
        Spacing="10">
        <Label 
            Text="Ingreso de Contactos"  
            FontSize="Title"
            TextColor="BlueViolet"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Picker 
            x:Name="pickerTipoIdentificacion" 
            Title="Seleccione el tipo de identificación">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Cédula</x:String>
                    <x:String>Pasaporte</x:String>
                    <x:String>RUC</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
            <Entry 
                x:Name="txtIdentificacion" 
                Placeholder="Ingrese la identificación" 
                Grid.Column="1" />
        </Grid>

        <Label 
            Text="Nombres:" 
            FontSize="Body"
            TextColor="Black" />
        <Entry 
            x:Name="txtNombres" 
            Placeholder="Ingrese los nombres" />
        <Label 
            Text="Apellidos:" 
            FontSize="Body"
            TextColor="Black" />
        <Entry 
            x:Name="txtApellidos" 
            Placeholder="Ingrese los apellidos" />
        
        <Label
     Text="Fecha de Nacimiento:"
     FontSize="Body"
     TextColor="Black" />
        <DatePicker
            x:Name="datePickerFechaNacimiento"
            Format="dd/MM/yyyy"  />
            
        <Label
            Text="Correo Electrónico:"
            FontSize="Body"
            TextColor="Black" />
        <Entry
            x:Name="txtCorreo"
            Placeholder="Ingrese el correo electrónico" />
        <Label
            Text="Salario:"
            FontSize="Body"
            TextColor="Black" />
        <Entry
            x:Name="txtSalario"
            Placeholder="Ingrese el salario" />

    </VerticalStackLayout>
</ContentPage>